# AION Git Ignore File
# CRITICAL: Never commit credentials!

# Environment files with secrets
.env
.env.local
.env.*.local
*.env

# Shadeform configuration with IDs
.shadeform_config
.current_instance
.archived_instance_*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Logs
*.log
logs/
/aion/logs/

# Data and models
/workspace/
/data/
/models/
/checkpoints/
*.h5
*.pkl
*.pth
*.ckpt

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docker
.dockerignore
docker-compose.override.yml

# Temporary files
*.tmp
*.bak
*.backup
tmp/
temp/

# API Keys and credentials
*_api_key*
*_token*
*_secret*
credentials/
secrets/

# S3 sync tracking
.s3_sync_state
.last_sync

# Instance tracking
instance_history/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
