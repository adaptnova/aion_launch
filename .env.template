# AION Environment Configuration Template
# Copy this to .env and fill with your actual values
# NEVER commit .env to git!

# Docker Hub (https://hub.docker.com/settings/security)
DOCKERHUB_USERNAME=adaptchase
DOCKERHUB_TOKEN=YOUR_DOCKER_HUB_PAT_HERE

# Shadeform API (https://platform.shadeform.ai/settings/api-keys)
SHADEFORM_API_KEY=YOUR_SHADEFORM_API_KEY_HERE

# Nebius COS S3 Configuration
AWS_ACCESS_KEY_ID=YOUR_NEBIUS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_NEBIUS_SECRET_KEY
AWS_ENDPOINT_URL=https://storage.us-central1.nebius.cloud:443
AWS_DEFAULT_REGION=us-central1
S3_BUCKET=cos
S3_PREFIX=aion/runs/

# AION Configuration
AION_MODE=FULL_AUTONOMY
AION_TRUST_LEVEL=COMPLETE
AION_RESTRICTIONS=NONE

# GPU Configuration
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
GPU_COUNT=8
GPU_TYPE=H200

# Auto-deletion (set to true for ephemeral instances)
AUTO_DELETE=false

# Instance naming
INSTANCE_PREFIX=aion

# GitHub (for tracking commits in runs)
GITHUB_TOKEN=YOUR_GITHUB_PAT_HERE

# Optional: AI Service Keys (if needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGING_FACE_TOKEN=